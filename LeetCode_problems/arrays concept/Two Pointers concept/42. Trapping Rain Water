class Solution {
    public int trap(int[] height) {
        int ans =0;
        int n = height.length;
        int l = 0;
        int r = n-1;
        int leftmax = height[l];
        int rightmax = height[r];
        while(l < r){
            if(leftmax < rightmax){
                ans+=leftmax-height[l];
                l++;
                if(l < r){
                    leftmax = Math.max(leftmax , height[l]);
                }  
            }
            else{ 
                ans+= rightmax - height[r];
                r--; 
                if(l < r){
                    rightmax = Math.max(rightmax , height[r]);
                }  
            }
        }
        return ans;
    }
}//Hard