class Solution {
    public int firstocc(int[] nums , int target){
        int ans1 = -1;
        int res = 0;
        int lef = 0;
        int rig = nums.length-1;
        while(lef <= rig ){
            int mid =lef+(rig - lef)/2;
            if(nums[mid] == target){
                ans1 = mid;
                rig = mid - 1;
            }
            else if(nums[mid] < target){
                lef = mid+1;
            }
            else{
                rig = mid-1;
            }
        }
        return ans1;
    }
    public int lastocc(int[] nums , int target){
        int ans2 = -1;
        int res = 0;
        int lef = 0;
        int rig = nums.length-1;
        while(lef <= rig ){
            int mid =lef+(rig - lef)/2;
            if(nums[mid] == target){
                ans2 = mid;
                lef = mid+1;
            }
            else if(nums[mid] < target){
                lef = mid+1;
            }
            else{
                rig = mid-1;
            }
        }
        return ans2;
    }
    public int[] searchRange(int[] nums, int target) {
        int first = firstocc(nums , target);
        int last = lastocc(nums , target);
        int[] result = new int[2];
        result[0] = first;
        result[1] = last;
        return result;
        
    }
}